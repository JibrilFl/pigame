[Unit]
Description=PiGame desktop manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pizero
WorkingDirectory=/home/pizero/pigame
Environment=PYTHONPATH=/home/pizero/pigame/src
ExecStart=/home/pizero/pigame/.venv/bin/python -m pigame.desktop_server --host 0.0.0.0 --port 8080 --save /home/pizero/pigame/data/save.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
