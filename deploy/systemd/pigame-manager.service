[Unit]
Description=PiGame desktop manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pigame
Environment=PYTHONPATH=/home/pi/pigame/src
ExecStart=/usr/bin/python3 -m pigame.desktop_server --host 0.0.0.0 --port 8080 --save /home/pi/pigame/data/save.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
