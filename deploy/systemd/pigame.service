[Unit]
Description=PiGame idle RPG device daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pizero
WorkingDirectory=/home/pizero/pigame
Environment=PYTHONPATH=/home/pizero/pigame/src
ExecStart=/home/pizero/pigame/.venv/bin/python -m pigame.runtime --renderer waveshare --battery-backend cw2015 --battery-bus 1 --battery-address 0x62 --low-battery-percent 15 --critical-battery-percent 5 --shutdown-command "systemctl poweroff" --tick-seconds 180 --save /home/pizero/pigame/data/save.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
